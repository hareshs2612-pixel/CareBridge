# CareBridge Backend Configuration
CAREBRIDGE_PORT=8787
CAREBRIDGE_CORS_ORIGIN=http://localhost:5173

# Optional Real SMS OTP Gateway Configuration (Production / Evaluator Credentials):
# If neither is set, CareBridge uses the Secure Server Console Gateway:
# The server logs the dispatched random 6-digit OTP directly into the backend terminal.
# The OTP is NEVER returned to the frontend or exposed in API responses.

# 1. Fast2SMS (Recommended for Indian Mobile Numbers):
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# 2. Twilio SMS:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
